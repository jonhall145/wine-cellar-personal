# Django
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=wine_cellar.conf.docker_prod_settings
SECRET_KEY=CHANGE-ME-TO-A-REAL-SECRET-KEY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
SITE_URL=https://your-domain.com

# Database
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=wine_cellar_prod
SQL_USER=wine_cellar_user
SQL_PASSWORD=CHANGE-ME-TO-A-STRONG-PASSWORD
SQL_HOST=db
SQL_PORT=5432
DATABASE=postgres

# Redis
REDIS_URL=redis://redis:6379/1

# Admin user
ADMIN_USER=admin
ADMIN_USER_EMAIL=admin@example.org
ADMIN_USER_PASSWORD=CHANGE-ME

# Optional
ANTHROPIC_API_KEY=
SENTRY_DSN=

# PostgreSQL container
POSTGRES_DB=wine_cellar_prod
POSTGRES_USER=wine_cellar_user
POSTGRES_PASSWORD=CHANGE-ME-TO-A-STRONG-PASSWORD
